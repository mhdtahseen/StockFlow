{
  "name": "finventree-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "deploy": "turbo deploy",
    "deploy:preview": "turbo deploy:preview",
    "deploy:web": "pnpm --filter @finventree/web deploy",
    "deploy:app": "pnpm --filter @finventree/app deploy",
    "deploy:admin": "pnpm --filter @finventree/admin deploy",
    "dev:app": "pnpm --filter @finventree/app dev",
    "dev:admin": "pnpm --filter @finventree/admin dev",
    "dev:web": "pnpm --filter @finventree/web dev",
    "build:app": "pnpm --filter @finventree/app build",
    "build:admin": "pnpm --filter @finventree/admin build",
    "build:web": "pnpm --filter @finventree/web build"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "wrangler": "^4.90.0"
  }
}
